 "structures": [
  {
   "id": "pas-seulement",
   "regex": "(?i)\\bce n'?est pas (?:seulement|juste|qu'?un[e]?) [^.!?\\n]{2,60}[,.] c'?est\\b",
   "name": "« Ce n'est pas juste X, c'est Y »",
   "fix": "Dis la seule chose que tu veux dire. Supprime la moitié de mise en scène."
  },
  {
   "id": "non-seulement",
   "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
   "name": "« Non seulement X mais aussi Y »",
   "fix": "Deux phrases, ou garde la plus forte."
  },
  {
   "id": "pas-une-question-de",
   "regex": "(?i)\\bce n'?est pas une question de [^.!?\\n]{2,60}[.!] c'?est une question de\\b",
   "name": "« Ce n'est pas une question de X. C'est une question de Y. »",
   "fix": "Commence par Y."
  },
  {
   "id": "le-resultat",
   "regex": "(?i)^\\s*(?:le résultat|le meilleur|le hic|le piège|la suite)\\s*\\?\\s*$",
   "name": "Ligne-question qui met en scène une révélation",
   "fix": "Donne la réponse dans la phrase."
  },
  {
   "id": "voici-ce-que",
   "regex": "(?i)\\bvoici ce que (?:j'?ai|nous avons|on a) appris\\b",
   "name": "« Voici ce que j'ai appris »",
   "fix": "Dis la leçon, sans l'annoncer."
  },
  {
   "id": "triade",
   "regex": "(?i)\\b\\w+, \\w+ et \\w+\\.",
   "name": "Trio rythmé « X, Y et Z. »",
   "fix": "Deux éléments ou quatre. Trois, c'est le rythme par défaut des textes générés."
  },
  {
   "id": "mur-hashtags",
   "regex": "(?:#\\w+[ \\t]*){6,}",
   "name": "Mur de hashtags (6+)",
   "fix": "5 maximum, liés au sujet (PLAYBOOK)."
  },
  {
   "id": "en-tant-qu-ia",
   "regex": "(?i)\\ben tant qu'?(?:ia|intelligence artificielle|modèle de langage)\\b",
   "name": "Le modèle parle de lui",
   "fix": "Supprime la phrase."
  },
  {
   "id": "conclusion",
   "regex": "(?im)^\\s*(?:en résumé|pour résumer|en conclusion|pour conclure)\\b",
   "name": "Ouverture de conclusion de dissertation",
   "fix": "Une publication n'a pas besoin de paragraphe de conclusion."
  },
  {
   "id": "appat-reflexe",
   "regex": "(?i)\\b(?:d'accord \\?|vous en pensez quoi \\?|qu'en pensez-vous \\?|qui d'autre\\b|j'ai tort \\?)\\s*$",
   "name": "Appât à commentaires réflexe",
   "fix": "Pose une question que toi seul peux poser, sur ce qui précède."
  },
  {
   "id": "stop-scroll",
   "regex": "(?im)^\\s*(?:arrête(?:z)? de scroller|ne scrolle(?:z)? pas|attends,? ne scrolle pas)\\b",
   "name": "Ouverture « arrête de scroller »",
   "fix": "L'arrêt du pouce doit venir de l'affirmation elle-même."
  },
  {
   "id": "dans-cette-video",
   "regex": "(?i)\\b(?:dans (?:cette|la) (?:vidéo|publication)|aujourd'?hui je vais (?:vous|te) montrer|je vais (?:vous|te) (?:montrer|apprendre) comment)\\b",
   "name": "Préambule de vidéo",
   "fix": "Supprime-le et commence par la réponse."
  },
  {
   "id": "majuscules",
   "regex": "\\b[A-ZÀ-Þ]{3,}\\b(?:\\s+\\b[A-ZÀ-Þ]{3,}\\b){2,}",
   "name": "Trois mots ou plus en majuscules d'affilée",
   "fix": "Les majuscules montent le volume. Un mot au maximum."
  },
  {
   "id": "appat-abonnement",
   "regex": "(?i)\\b(?:abonne-toi pour plus|abonnez-vous pour plus|tague quelqu'?un qui|identifie quelqu'?un qui|double tape si|like si)\\b",
   "name": "Appât réflexe (abonnement, identification)",
   "fix": "Demande la seule action que la publication mérite."
  }
 ]
}